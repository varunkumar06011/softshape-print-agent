<?xml version="1.0" encoding="UTF-16"?>
<!--
  SoftShape Runtime Host — Task Scheduler Fallback (Phase 7)
  ──────────────────────────────────────────────────────────────
  This scheduled task provides a second-level recovery mechanism.
  If the Runtime Host (softshape-host.exe) crashes or is killed,
  Windows Task Scheduler restarts it within 5 minutes.

  Primary recovery: The Host supervises the Runtime (edge-server.exe).
  This fallback: Task Scheduler supervises the Host itself.

  Installation:
    schtasks /create /tn "SoftShape Host Monitor" /xml softshape-host-monitor.xml /f

  The task is triggered:
    - At user logon (ensures Host starts even if autostart registry key fails)
    - Every 5 minutes (recurring trigger — restarts Host if it has crashed)

  The task runs with:
    - Normal priority
    - No time limit
    - Restart on failure (up to 3 times within 15 minutes)
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Restarts the SoftShape Runtime Host if it crashes or is killed. The Host supervises the edge-server.exe Runtime process.</Description>
    <URI>\SoftShape Host Monitor</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
    <TimeTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT5M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>softshape-host.exe</Command>
      <Arguments>--no-autostart</Arguments>
    </Exec>
  </Actions>
</Task>
